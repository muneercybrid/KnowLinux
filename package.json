{
  "name": "prisma-compute-hono",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "concurrently \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "cd web && bun run dev",
    "build": "bun run build:api && bun run build:web && bun run build:copy",
    "build:api": "bun run contract:emit && tsc",
    "build:web": "cd web && bun install && bun run build",
    "build:copy": "rm -rf dist/public && cp -r web/dist dist/public",
    "start": "node dist/index.js",
    "contract:emit": "prisma contract emit",
    "migration:plan": "prisma migration plan",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:seed": "tsx src/prisma/seed.ts",
    "compute:login": "prisma auth login",
    "compute:database:create": "prisma postgres create prisma-compute-hono -branch main",
    "compute:connect": "prisma git connect",
    "compute:open": "prisma service open"
  },
  "dependencies": {
    "@hono/node-server": "2.0.4",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/composer": "0.29.1",
    "@prisma/composer-prisma-cloud": "0.29.1",
    "@prisma/orm-postgres": "8.0.0-rc.17",
    "dotenv": "17.4.2",
    "hono": "4.12.34",
    "temporal-polyfill": "1.0.5"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "alchemy": "2.0.0-beta.78",
    "prisma": "8.0.0-rc.22",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "concurrently": "^9.1.0"
  }
}
