// use prisma-8

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  username      String?        @unique
  name          String?
  passwordHash  String?
  posts         Post[]
  sessions      Session[]
  savedCommands SavedCommand[]
  createdAt     DateTime       @default(now())
  updatedAt     temporal.updatedAt()
  @@map("user")
}

model SavedCommand {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  command     String
  description String
  createdAt   DateTime @default(now())
  @@map("saved_command")
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@map("session")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  @@map("post")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  slug        String     @unique
  description String
  icon        String
  letter      String     // A-Z
  keywords    String     @default("") // Comma-separated search terms
  parentId    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  tools       Tool[]
  createdAt   DateTime   @default(now())
  updatedAt   temporal.updatedAt()
  @@map("category")
}

model Tool {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()
  @@map("tool")
}

model Distribution {
  id             Int                    @id @default(autoincrement())
  name           String                 @unique
  slug           String                 @unique
  family         String
  packageManager String
  softwares      SoftwareDistribution[]
  createdAt      DateTime               @default(now())
  updatedAt      temporal.updatedAt()
  @@map("distribution")
}

model Software {
  id            Int                    @id @default(autoincrement())
  name          String                 @unique
  slug          String                 @unique
  description   String
  category      String
  isVerified    Boolean                @default(false)
  distributions SoftwareDistribution[]
  createdAt     DateTime               @default(now())
  updatedAt     temporal.updatedAt()
  @@map("software")
}

model SoftwareDistribution {
  softwareId     Int
  distributionId Int
  installCommand String
  software       Software     @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  distribution   Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  @@id([softwareId, distributionId])
  @@map("software_distribution")
}

model Command {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String
  syntax      String
  category    String
  examples    String
  parameters  String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()
  @@map("command")
}

model TroubleshootingCase {
  id             Int      @id @default(autoincrement())
  title          String
  slug           String   @unique
  errorSignature String
  explanation    String
  causes         String
  diagnostics    String
  fixes          String
  verification   String
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()
  @@map("troubleshooting_case")
}
